.card {
  background: rgba(255,255,255,0.05);
  border-radius: 18px;
  padding: 20px;
  text-align: center;
  backdrop-filter: blur(10px);
  transition: 0.3s;
  border: 1px solid rgba(255,255,255,0.08);
}

.card:hover {
  transform: translateY(-6px);
  border-color: var(--pink);
}

.item-img {
  width: 100%;
  height: 140px;
  object-fit: contain;
  margin-bottom: 10px;
}

.card h3 {
  margin: 10px 0 5px;
}

.raridade {
  color: #ff4ecd;
  font-weight: 600;
}

.raridade.lend {
  color: #ff9a3c;
}

.preco {
  display: block;
  margin: 10px 0;
  font-size: 18px;
  font-weight: bold;
}

.card button {
  width: 100%;
  padding: 12px;
  border-radius: 30px;
  border: none;
  background: linear-gradient(90deg, var(--pink), var(--purple));
  color: white;
  font-weight: 600;
  cursor: pointer;
}